{
  "redirects": [
    {
      "source": "/vagas",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/vagas/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/(.*)",
      "destination": "/en/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
